{
  "name": "boqlet",
  "private": true,
  "version": "0.1.0",
  "description": "boqlet: IFC -> Bill of Quantities. Product root (P44): the Next.js app, the Java backend, the Python engine.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests"
  ],
  "scripts": {
    "postinstall": "node scripts/setup-engine.mjs",
    "setup:engine": "node scripts/setup-engine.mjs --force",
    "dev:app": "node scripts/local.mjs up && npm run dev -w @ifc-boq/app",
    "local:up": "node scripts/local.mjs up",
    "local:down": "node scripts/local.mjs down",
    "local:reset": "node scripts/local.mjs reset",
    "local:logs": "node scripts/local.mjs logs",
    "local:status": "node scripts/local.mjs status",
    "local:user": "node scripts/local.mjs user",
    "local:admin": "node scripts/local.mjs admin",
    "local:check": "node scripts/local.mjs check",
    "dev:engine-worker": "node scripts/run-engine.mjs worker",
    "build:app": "npm run build -w @ifc-boq/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @ifc-boq/app",
    "test:app": "npm run test -w @ifc-boq/app",
    "test:contract": "npm run contract -w @ifc-boq/tests",
    "test:scenarios": "npm run scenarios -w @ifc-boq/tests",
    "test": "npm run typecheck && npm run lint && npm run test:app && npm run test:engine",
    "test:engine": "node scripts/run-engine.mjs test",
    "boq": "node scripts/run-engine.mjs cli",
    "corpus": "node scripts/run-engine.mjs corpus",
    "catalogue": "node scripts/run-engine.mjs catalogue",
    "codegen": "npm run codegen -w @ifc-boq/types",
    "import:uniclass": "node scripts/run-engine.mjs import-uniclass",
    "api:lint": "redocly lint packages/api/openapi.yaml packages/pricing-api/openapi-pricing.yaml --config packages/api/redocly.yaml",
    "api:gen": "node scripts/api-codegen.mjs",
    "api:check": "node scripts/api-codegen.mjs --check"
  },
  "devDependencies": {
    "@redocly/cli": "2.77.0",
    "concurrently": "^9.2.5",
    "openapi-typescript": "7.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
