{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Decision",
  "definitions": {
    "Decision": {
      "type": "object",
      "properties": {
        "questionId": {
          "type": "string",
          "description": "Question.id. Ids are deterministic (built from content), so they stay stable across runs."
        },
        "scope": {
          "type": "string",
          "enum": [
            "project",
            "company"
          ]
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/LineOverrideEdit"
            }
          ]
        },
        "note": {
          "type": "string"
        },
        "decidedBy": {
          "type": "string"
        },
        "decidedAt": {
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "scope",
        "answer"
      ],
      "additionalProperties": false,
      "description": "A user's answer to a Question. Decisions are stored per project (or promoted to company level) and re-applied on every run and every new model version, so the same question is never asked twice."
    },
    "LineOverrideEdit": {
      "type": "object",
      "properties": {
        "quantity": {
          "type": [
            "number",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/definitions/Unit"
        },
        "codes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "An engine decision with a questionId of `override:{lineKey}`."
    },
    "Unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "enum": [
            "nr",
            "item",
            "sum",
            "mm",
            "m",
            "km",
            "m2",
            "m3",
            "kg",
            "t",
            "ft",
            "ft2",
            "ft3",
            "yd2",
            "yd3",
            "lb",
            "h"
          ]
        }
      ]
    }
  }
}
